# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode used to authenticate authorized administrators in the Admin Dashboard.
# Recommended: set a strong custom passcode in your environment secrets before public deployment.
ADMIN_PASSCODE=""

# PAYMENT GATEWAY CREDENTIALS (Configure either Stripe or Razorpay for live online checkout)
STRIPE_SECRET_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
